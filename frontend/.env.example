# 前端环境变量模板。复制为 .env.development 后按需修改。
#
# 与后端 `.env` 的区分（重要）：
#   - 这里只放**前端可见**的配置。Vite 会把 `VITE_` 开头的变量打进浏览器产物，
#     任何写在这里的值都等于公开。
#   - **前端不得持有任何服务端 Key**（LLM / 地图 / 天气）——
#     那些一律走 backend/.env（实际位置：仓库根 .env），由后端持有。
#   - `.env.*` 已被仓库 .gitignore 忽略，只有本模板文件会被提交。

# 后端地址。留空 = 走同源，由 vite.config.ts 的 /api 代理转发到 127.0.0.1:8000。
# 部署到不同域名时才需要填完整地址。
VITE_API_BASE_URL=

# 是否允许"载入示例攻略 / 演示追问卡"这两个本地演示入口。
# 它们直接读仓库 fixtures/valid/*.json，**不经过后端**，界面上会显式标注为示例数据。
# 正式演示或上线时设为 false。
VITE_ENABLE_FIXTURE_DEMO=true
