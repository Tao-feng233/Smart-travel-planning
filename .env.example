# 在本地填写。不要提交实际 .env。
QWEATHER_API_HOST=your-api-host.qweatherapi.com
QWEATHER_API_KEY=
QWEATHER_TIMEOUT_SECONDS=5
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
AMAP_API_KEY=
TUNIU_API_KEY=
# 可选：主 key 失效或被限流时自动改用的备用 key，留空则不启用回落
TUNIU_API_KEY_FALLBACK=
# 可选：项目自身的只读查询预算，不代表供应商实际额度
TUNIU_DAILY_LIMIT=40

# 网站自身的访问来源；公网部署时改为实际HTTPS域名并配置反向代理
APP_PUBLIC_ORIGIN=http://127.0.0.1:8767

# 空URL使用持久化本地Qdrant；部署时填写服务端地址。
QDRANT_URL=
QDRANT_API_KEY=
RAG_INDEX_PATH=data/runtime/knowledge-index
RAG_MODEL_CACHE=data/runtime/embedding-models
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# api模式支持兼容/embeddings的服务；使用时同时修改模型名。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RAG_DENSE_MIN_SCORE=0.58
