# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不得提交真实 Key。
# 前端不得持有任何服务端 API Key。

LLM_PRIMARY_PROVIDER=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_MODEL=

LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# 地图 / 天气 Key（可选）。高德 Web 服务 Key 优先读 AMAP_API_KEY，
# 兼容旧名 MAP_API_KEY；两者都为空时 HYBRID 模式的 get_route 不会发 HTTP 请求，
# 会直接回退到 Mock 路线。真实 Key 不得写进代码、文档、日志或前端。
AMAP_API_KEY=
MAP_API_KEY=
WEATHER_API_KEY=
AMAP_TIMEOUT_SECONDS=5

# A 线数据与 MCP Server
# DATA_MODE=MOCK   全部使用 Mock（默认，不需要真实 API Key，行为不变）
# DATA_MODE=HYBRID 仅 get_route 走高德实时路线（网络/业务错误、空结果或 Key 缺失时
#                  自动回退现有 Mock 路线，且回退结果 source 仍为 MOCK）；
#                  景点、住宿、餐厅、天气、城际交通、准备规则等其余 8 个工具仍用 Mock。
# 两种模式下整体都是 DEMO/含 Mock，前端必须继续显示 Mock 警告。
DATA_MODE=MOCK
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001

# C 线 P0 状态存储：MEMORY 表示使用内存 + JSON 快照的 Repository 实现
PLAN_STORE_BACKEND=MEMORY
PLAN_STORE_DIR=.local/plan_store
