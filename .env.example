# 在本地填写。不要提交实际 .env。
QWEATHER_API_HOST=your-api-host.qweatherapi.com
QWEATHER_API_KEY=
QWEATHER_TIMEOUT_SECONDS=5
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
AMAP_API_KEY=
TUNIU_API_KEY=
# 可选：项目自身的只读查询预算，不代表供应商实际额度
TUNIU_DAILY_LIMIT=40

# 网站自身的访问来源；公网部署时改为实际HTTPS域名并配置反向代理
APP_PUBLIC_ORIGIN=http://127.0.0.1:8767
