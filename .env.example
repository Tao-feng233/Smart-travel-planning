# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不得提交真实 Key。
# 前端不得持有任何服务端 API Key。

LLM_PRIMARY_PROVIDER=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_MODEL=

LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

MAP_API_KEY=
WEATHER_API_KEY=

# C 线 P0 状态存储：MEMORY 表示使用内存 + JSON 快照的 Repository 实现
PLAN_STORE_BACKEND=MEMORY
PLAN_STORE_DIR=.local/plan_store
