# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不得提交真实 Key。
# 前端不得持有任何服务端 API Key。

LLM_PRIMARY_PROVIDER=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_MODEL=

LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

MAP_API_KEY=
WEATHER_API_KEY=

# A 线数据与 MCP Server；P0 使用 MOCK，不需要真实 API Key
DATA_MODE=MOCK
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001

# C 线 P0 状态存储：MEMORY 表示使用内存 + JSON 快照的 Repository 实现
PLAN_STORE_BACKEND=MEMORY
PLAN_STORE_DIR=.local/plan_store

